@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<div class="auth-wrap">
    <h1>Create account</h1>
    <div class="panel">
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autocomplete="name" autofocus />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="mb-4">
                <span class="form-label d-block">I'm using RaceDay to</span>
                <div class="role-choice">
                    <label>
                        <input type="radio" asp-for="Role" value="@Roles.Participant" /> Enter races
                        <small>Find events and enrol in a category.</small>
                    </label>
                    <label>
                        <input type="radio" asp-for="Role" value="@Roles.Organiser" /> Run events
                        <small>Create events, manage categories and publish results.</small>
                    </label>
                </div>
                <span asp-validation-for="Role"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>
    </div>
    <p class="mt-3">Already registered? <a asp-action="Login">Log in</a></p>
</div>
